# ============================================================
# MY AI Agent — 環境変数
# cp .env.example .env して値を入力してください
# .env は絶対にGitにコミットしないこと！
# ============================================================

# ── サーバー ──────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
# 本番: APP_URL=https://your-app.railway.app

# ── 必須: JWTシークレット ─────────────────────────────────────
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

# ── 必須: Anthropic API Key ───────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── 推奨: Supabase ────────────────────────────────────────────
# https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJh...service-role-key

# ── Stripe (本番課金) ─────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Google OAuth ──────────────────────────────────────────────
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Authorized redirect URIs に追加: https://your-app.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxx

# ── Resend (メール送信) ───────────────────────────────────────
# https://resend.com → API Keys
# ※未設定時はコンソールにメール内容を出力（開発用）
RESEND_API_KEY=re_xxxxxx
FROM_EMAIL=noreply@myaiagent.jp

# ── 為替レート ────────────────────────────────────────────────
USD_TO_JPY=150

# ── SEO 日次レポート (protocol.ooo / GSC + GA4 → Claude 分析 → メール) ──
# セットアップ手順は docs/SEO_REPORT.md を参照。
# 1 にすると毎朝 SEO_REPORT_HOUR 時 (JST) に自動送信。
SEO_REPORT=0
# レポートの送信先メールアドレス
SEO_REPORT_TO=kota.takeuchi@protocol.ooo
# 送信時刻 (JST, 0-23)。未指定なら 8
SEO_REPORT_HOUR=8
# Search Console のプロパティ。ドメインプロパティは "sc-domain:protocol.ooo"
SEO_GSC_SITE_URL=sc-domain:protocol.ooo
# GA4 プロパティ ID (数字のみ。GA4管理画面 → プロパティ設定 で確認)
SEO_GA4_PROPERTY_ID=000000000
# サービスアカウントの JSON キー全体を1行で貼り付け (改行は \n のままでOK)
SEO_GOOGLE_SA_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com",...}
# 動作確認用: 1 にすると起動 20 秒後に一度だけテスト送信する (確認後 0 に戻す)
SEO_REPORT_RUN_ON_BOOT=0
